{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ran (Rust): emulate",
      "type": "lldb",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "cargo": {
        "args": [
          "build",
          "-p",
          "cli",
          "--bin",
          "ran"
        ],
        "filter": {
          "name": "ran",
          "kind": "bin"
        }
      },
      "args": [
        "emulate",
        "--port",
        "8080",
        "--kubeconfig",
        "ixi-config.yaml"
      ],
      "env": {
        "RAN_LOG": "debug"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Ran: plan",
      "type": "lldb",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "cargo": {
        "args": [
          "build",
          "-p",
          "cli",
          "--bin",
          "ran", 
        ],
        "filter": {
          "name": "ran",
          "kind": "bin"
        }
      },
      "args": [
        "emulate",
        "--port",
        "8080",
        "--kubeconfig",
        "ixi-config.yaml",
        "--plan",
        "examples/KubeConEU-2026/redis-nodeproxy-argo.plan.yaml"
      ],
      "env": {
        "RAN_LOG": "debug"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Ran (Rust): trigger",
      "type": "lldb",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "cargo": {
        "args": [
          "build",
          "-p",
          "cli",
          "--bin",
          "ran"
        ],
        "filter": {
          "name": "ran",
          "kind": "bin"
        }
      },
      "args": [
        "trigger",
        "get-pods",
        "--target",
        "ns/dev/pod/workstation-7885f9c4f8-bbhgp",
        "--kubeconfig",
        "ixi-config.yaml"
      ],
      "env": {
        "RAN_LOG": "debug"
      },
      "console": "integratedTerminal"
    },
  ],
}
