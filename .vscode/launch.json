{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ran (Rust): emulate",
      "type": "lldb",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "cargo": {
        "args": [
          "build",
          "-p",
          "cli",
          "--bin",
          "ran"
        ],
        "filter": {
          "name": "ran",
          "kind": "bin"
        }
      },
      "args": [
        "emulate",
        "--port",
        "8080",
        "--kubeconfig",
        "ixi-config.yaml"
      ],
      "env": {
        "RAN_LOG": "debug"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Ran: plan",
      "type": "lldb",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "cargo": {
        "args": [
          "build",
          "-p",
          "cli",
          "--bin",
          "ran", 
        ],
        "filter": {
          "name": "ran",
          "kind": "bin"
        }
      },
      "args": [
        "emulate",
        "--port",
        "8080",
        "--kubeconfig",
        "ixi-config.yaml",
        "--plan",
        "examples/KubeConEU-2026/redis-nodeproxy-argo.plan.yaml"
      ],
      "env": {
        "RAN_LOG": "debug"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Ran (Rust): trigger",
      "type": "lldb",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "cargo": {
        "args": [
          "build",
          "-p",
          "cli",
          "--bin",
          "ran"
        ],
        "filter": {
          "name": "ran",
          "kind": "bin"
        }
      },
      "args": [
        "trigger",
        "get-pods",
        "--target",
        "ns/dev/pod/workstation-7885f9c4f8-bbhgp",
        "--kubeconfig",
        "ixi-config.yaml"
      ],
      "env": {
        "RAN_LOG": "debug"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Generate Mitre Stix",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/src/mitre/gen_mappings.go",
      "args": [
        "https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack.json",
      ],
    },
    {
      "name": "Atomic: Get Pods",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/src",
      "console": "integratedTerminal",
      "args": [
        "invoke",
        "get-pods",
        // "--target",
        // "ns/dev/pod/workstation-7885f9c4f8-bbhgp"
      ],
      // "program": "${fileDirname}"
    },
    {
      "name": "Atomic: Get SAs",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/src",
      "console": "integratedTerminal",
      "args": [
        "invoke",
        "Get ServiceAccounts via API Server",
        "--target",
        "ns/dev/pod/workstation-7885f9c4f8-bbhgp",
      ],
      // "program": "${fileDirname}"
    },
    {
      "name": "Atomic: Get SA Token",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/src",
      "console": "integratedTerminal",
      "args": [
        "invoke",
        "Read Service Account Token",
        "--target",
        "ns/dev/pod/workstation-7885f9c4f8-bbhgp",
      ],
      // "program": "${fileDirname}"
    },
    {
      "name": "Atomic Check Token Permissions",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/src",
      "console": "integratedTerminal",
      "args": [
        "invoke",
        "Check Token permissions",
        "--target",
        "ns/dev/sa/developer",
      ],
      // "program": "${fileDirname}"
    },
    {
      "name": "Atomic Create Role",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/src",
      "console": "integratedTerminal",
      "args": [
        "invoke",
        "Create Admin Role",
        "--role-name",
        "nsadmin",
        "--namespace",
        "dev",
      ],
    },
    {
      "name": "Ran: serve",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "cwd": "${workspaceFolder}/src",
      "program": "${workspaceFolder}/src",
      "console": "integratedTerminal",
      "env": {
        "RAN_DEBUG": "1"
      },
      "args": [
        "emulate",
        "--kubeconfig",
        "../ixi-config.yaml",
        "--armory",
        "../armory/TTPs"
      ],
    },
  ],
}