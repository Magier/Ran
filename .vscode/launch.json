  "version": "0.2.0",
  "configurations": [
    {
      "name": "Generate Mitre Stix",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/src/mitre/gen_mappings.go",
      "args": [
        "https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack.json",
      ],
    },
    {
      "name": "Atomic: Get Pods",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/src",
      "console": "integratedTerminal",
      "args": [
        "invoke",
        "get-pods",
        // "--target",
        // "ns/dev/pod/workstation-7885f9c4f8-bbhgp"
      ],
      // "program": "${fileDirname}"
    },
    {
      "name": "Atomic: Get SAs",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/src",
      "console": "integratedTerminal",
      "args": [
        "invoke",
        "Get ServiceAccounts via API Server",
        "--target",
        "ns/dev/pod/workstation-7885f9c4f8-bbhgp",
      ],
      // "program": "${fileDirname}"
    },
    {
      "name": "Atomic: Get SA Token",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/src",
      "console": "integratedTerminal",
      "args": [
        "invoke",
        "Read Service Account Token",
        "--target",
        "ns/dev/pod/workstation-7885f9c4f8-bbhgp",
      ],
      // "program": "${fileDirname}"
    },
    {
      "name": "Atomic Check Token Permissions",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/src",
      "console": "integratedTerminal",
      "args": [
        "invoke",
        "Check Token permissions",
        "--target",
        "ns/dev/sa/developer",
      ],
      // "program": "${fileDirname}"
    },
    {
      "name": "Atomic Create Role",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/src",
      "console": "integratedTerminal",
      "args": [
        "invoke",
        "Create Admin Role",
        "--role-name",
        "nsadmin",
        "--namespace",
        "dev",
      ],
      // "program": "${fileDirname}"
    },
    {
      "name": "TUI: targeted",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/src",
      "console": "integratedTerminal",
      "args": ["emulate", "--target", "default/kubelet-reader-pod"],
      // "program": "${fileDirname}"
    },
    {
      "name": "Ran: serve",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "cwd": "${workspaceFolder}/src",
      "program": "${workspaceFolder}/src",
      "console": "integratedTerminal",
      "env": {"RAN_DEBUG": "1"},
      "args": ["emulate"],
      // "program": "${fileDirname}"
    },
    {
      "name": "TUI: Ran emulate plan",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/src",
      "console": "integratedTerminal",
      "args": [
        "emulate",
        // "--target",
        // "default/kubelet-reader-pod",
        // "-p",
        // "../campaign_2025-03-03T06-31-16.json",
      ],
      // "program": "${fileDirname}"
    },
    {
      "name": "Wails: Debug frontend",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceFolder}/RanUI/build/bin/frontend",
      "preLaunchTask": "build debug",
      "cwd": "${workspaceFolder}",
    },
    // {
    //     "name": "Wails: Debug myproject",
    //     "type": "go",
    //     "request": "launch",
    //     "mode": "exec",
    //     "program": "${workspaceFolder}/RanUI/build/bin/RanUI.app",
    //     "preLaunchTask": "build",
    //     "cwd": "${workspaceFolder}",
    //     "env": {}
    // },
    {
      "name": "Wails: Production frontend",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceFolder}/RanUI/build/bin/frontend",
      "preLaunchTask": "build",
      "cwd": "${workspaceFolder}",
    },
    {
      "name": "Wails: Dev frontend",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceFolder}/RanUI/build/bin/frontend",
      "preLaunchTask": "build dev",
      "cwd": "${workspaceFolder}",
    },
    // {
    //     "type": "julia",
