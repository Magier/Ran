    "version": "0.2.0",
    "configurations": [
        {
            "name": "Generate Mitre Stix",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/src/mitre/gen_mappings.go",
            "args": [
                "https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack.json"
            ]
        },
        {
            "name": "Go Ran",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/src",
            "console": "integratedTerminal",
            "args": [
                "invoke",
                "--godmode"
            ]
            // "program": "${fileDirname}"
        },
        {
            "name": "Go Ran targeted",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/src",
            "console": "integratedTerminal",
            "args": [
                "invoke",
                "--target",
                "default/kubelet-reader-pod"
            ]
            // "program": "${fileDirname}"
        },
        {
            "name": "Go Ran emulate plan",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/src",
            "console": "integratedTerminal",
            "args": [
                "emulate",
                "--target",
                "default/kubelet-reader-pod",
                "-p",
                "../campaign_2025-03-03T06-31-16.json",
            ]
            // "program": "${fileDirname}"
        },
        {
            "name": "Wails: Debug frontend",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${workspaceFolder}/RanUI/build/bin/frontend",
            "preLaunchTask": "build debug",
            "cwd": "${workspaceFolder}"
        },
        // {
        //     "name": "Wails: Debug myproject",
        //     "type": "go",
        //     "request": "launch",
        //     "mode": "exec",
        //     "program": "${workspaceFolder}/RanUI/build/bin/RanUI.app",
        //     "preLaunchTask": "build",
        //     "cwd": "${workspaceFolder}",
        //     "env": {}
        // },
        {
            "name": "Wails: Production frontend",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${workspaceFolder}/RanUI/build/bin/frontend",
            "preLaunchTask": "build",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Wails: Dev frontend",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${workspaceFolder}/RanUI/build/bin/frontend",
            "preLaunchTask": "build dev",
            "cwd": "${workspaceFolder}"
        }
        // {
        //     "type": "julia",
